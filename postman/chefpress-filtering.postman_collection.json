{
  "info": {
    "name": "Dev ChefPress Recipe Filter API",
    "_postman_id": "2ee9d1c9-306f-4adb-b7d0-5b5eadf6b8e8",
    "description": "Postman collection to test chefpress_filter_recipes AJAX endpoint. Test with 100 generated recipe products.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Week Filter (Auto, Frontend mode if <=50)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/wp-admin/admin-ajax.php",
          "host": ["{{baseUrl}}"],
          "path": ["wp-admin","admin-ajax.php"]
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {"key":"action","value":"chefpress_filter_recipes","type":"text"},
            {"key":"_chefpress_nonce","value":"{{chefpress_nonce}}","type":"text"},
            {"key":"week","value":"1","type":"text"},
            {"key":"filter_mode","value":"auto","type":"text"}
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has required fields\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('html');",
              "    pm.expect(jsonData).to.have.property('total_pages');",
              "    pm.expect(jsonData).to.have.property('current_page');",
              "    pm.expect(jsonData).to.have.property('total_count');",
              "    pm.expect(jsonData).to.have.property('recipes_count');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Multi-Tag Filter (Backend mode)",
      "request": {
        "method": "POST",
        "header": [{"key":"Content-Type","value":"application/x-www-form-urlencoded"}],
        "url": {"raw":"{{baseUrl}}/wp-admin/admin-ajax.php","host":["{{baseUrl}}"],"path":["wp-admin","admin-ajax.php"]},
        "body": {"mode":"urlencoded","urlencoded":[
          {"key":"action","value":"chefpress_filter_recipes","type":"text"},
          {"key":"_chefpress_nonce","value":"{{chefpress_nonce}}","type":"text"},
          {"key":"week","value":"2","type":"text"},
          {"key":"tags[]","value":"healthy","type":"text"},
          {"key":"tags[]","value":"quick","type":"text"},
          {"key":"filter_mode","value":"backend","type":"text"}
        ]}
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Returns HTML only in backend mode\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('html');",
              "    pm.expect(jsonData.recipes).to.be.an('array').that.is.empty;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Allergen Exclusion (NOT IN)",
      "request": {
        "method": "POST",
        "header": [{"key":"Content-Type","value":"application/x-www-form-urlencoded"}],
        "url": {"raw":"{{baseUrl}}/wp-admin/admin-ajax.php","host":["{{baseUrl}}"],"path":["wp-admin","admin-ajax.php"]},
        "body": {"mode":"urlencoded","urlencoded":[
          {"key":"action","value":"chefpress_filter_recipes","type":"text"},
          {"key":"_chefpress_nonce","value":"{{chefpress_nonce}}","type":"text"},
          {"key":"week","value":"1","type":"text"},
          {"key":"allergens[]","value":"peanuts","type":"text"},
          {"key":"allergens[]","value":"gluten","type":"text"},
          {"key":"filter_mode","value":"auto","type":"text"}
        ]}
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Excludes allergen-containing recipes\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.total_count).to.be.at.most(100);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Sort by Calories ASC",
      "request": {
        "method": "POST",
        "header": [{"key":"Content-Type","value":"application/x-www-form-urlencoded"}],
        "url": {"raw":"{{baseUrl}}/wp-admin/admin-ajax.php","host":["{{baseUrl}}"],"path":["wp-admin","admin-ajax.php"]},
        "body": {"mode":"urlencoded","urlencoded":[
          {"key":"action","value":"chefpress_filter_recipes","type":"text"},
          {"key":"_chefpress_nonce","value":"{{chefpress_nonce}}","type":"text"},
          {"key":"week","value":"1","type":"text"},
          {"key":"sort","value":"calories:ASC","type":"text"},
          {"key":"filter_mode","value":"frontend","type":"text"}
        ]}
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Returns recipe data in frontend mode\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.recipes).to.be.an('array');",
              "    if (jsonData.recipes.length > 0) {",
              "        pm.expect(jsonData.recipes[0]).to.have.property('calories');",
              "        pm.expect(jsonData.recipes[0]).to.have.property('protein');",
              "        pm.expect(jsonData.recipes[0]).to.have.property('carbs');",
              "        pm.expect(jsonData.recipes[0]).to.have.property('fat');",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
