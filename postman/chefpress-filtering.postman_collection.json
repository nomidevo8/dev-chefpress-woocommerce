  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "if (!pm.environment.get('chefpress_nonce')) {",
          "  console.log('Set chefpress_nonce in environment before request.');",
          "  console.log('Get nonce from: {{baseUrl}}/wp-admin/post.php?post=PRODUCT_ID&action=edit');",
          "}"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://aos-fresh.local",
      "type": "string"
    },
    {
      "key": "chefpress_nonce",
      "value": "",
      "type": "string",
      "description": "Get this from the recipe product edit page in WordPress admin"
    }
  ]
}
